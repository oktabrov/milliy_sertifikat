# Copy to .env and fill in. Never commit .env — it holds the bot token.

# From @BotFather
BOT_TOKEN=123456:replace-me

# Public HTTPS origin. On alwaysdata this is https://<account>.alwaysdata.net
# Required for the Mini App: Telegram refuses web_app buttons over plain HTTP.
WEBHOOK_BASE=
# Any long random string; it becomes part of the webhook path.
WEBHOOK_SECRET=change-me-to-something-random

# Local development without a public HTTPS URL: long-poll instead of a webhook.
USE_POLLING=false

# Directory holding users.json, tests.json and attempts.json.
# There is no database — storage is plain JSON files.
DATA_DIR=./data

# Comma-separated Telegram user ids that may run /stats and /broadcast.
ADMIN_IDS=

# Comma-separated channels a student must join first. Empty disables the gate.
# The bot must be an administrator in each channel to read membership.
REQUIRED_CHANNELS=

# Optional fallback for the "Botda test ishlash va yaratish(+video)" button.
# Admins manage the video inside the bot with /video and /video_ochirish; these
# are only used when nothing has been set at runtime.
HELP_VIDEO_URL=

# Optional: send the video itself instead of a link. Paste the file_id of a
# video already uploaded to Telegram (forward your video to @getidsbot and read
# its file_id). HELP_VIDEO_URL wins if both are set.
HELP_VIDEO_FILE_ID=

# Scoring
MIN_REAL_SUBMISSIONS=20
COHORT_SIZE=10000
BALL_MIDPOINT=50
BALL_SLOPE=16
BALL_BANDS=70:A+,65:A,60:B+,55:B,50:C+,46:C
